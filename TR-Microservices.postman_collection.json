              "raw": "{\n  \"jenisIzin\": \"Cuti Tahunan\",\n  \"tanggalMulai\": \"2026-08-02\",\n  \"tanggalSelesai\": \"2026-08-04\",\n  \"alasan\": \"Liburan keluarga (revisi tanggal)\"\n}"
